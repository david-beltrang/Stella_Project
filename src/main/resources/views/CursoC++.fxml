<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="1080.0" maxWidth="1920.0" minHeight="1080.0" minWidth="1920.0"
      prefHeight="1080.0" prefWidth="1920.0"
      stylesheets="@/styles/LoginStyle.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Infrastructure.controllers.PomodoroController">

    <!-- Contenedor principal -->
    <VBox layoutX="586.0" layoutY="156.0" prefHeight="694.0" prefWidth="707.0" spacing="30">

        <!-- Título -->
        <Label prefHeight="182.0" prefWidth="758.0" text="CURSO C++" textFill="white">
            <font><Font name="System Bold" size="120.0"/></font>
        </Label>

        <!-- Sección 1 -->
        <TitledPane expanded="true" prefHeight="143.0" prefWidth="638.0"
                    style="-fx-background-color: #809fff;" text="Sección 1: Introducción" textFill="WHITE">
            <content>
                <VBox opacity="0.92" spacing="10" style="-fx-background-color: #809fff;">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>

                    <!-- L1 -->
                    <Label text="Lección 1: ¿Qué es C++?" textFill="WHITE"
                           onMouseClicked="#goToLeccion1">
                        <font><Font name="Yu Gothic Light" size="17.0"/></font>
                    </Label>

                    <!-- L2 -->
                    <Label text="Lección 2: Instalación del entorno" textFill="WHITE"
                           onMouseClicked="#goToLeccion2">
                        <font><Font name="Yu Gothic Light" size="17.0"/></font>
                    </Label>

                    <!-- L3 -->
                    <Label text="Lección 3: Primer programa" textFill="WHITE"
                           onMouseClicked="#goToLeccion3">
                        <font><Font name="Yu Gothic Light" size="17.0"/></font>
                    </Label>
                </VBox>
            </content>
            <font><Font size="18.0"/></font>
        </TitledPane>

        <!-- Sección 2 -->
        <TitledPane style="-fx-background-color: #809fff;" text="Sección 2: Fundamentos" textFill="WHITE">
            <content>
                <VBox opacity="0.92" spacing="10" style="-fx-background-color: #809fff;">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>

                    <!-- L4 -->
                    <Label text="Lección 1: Variables y tipos de datos" textFill="WHITE"
                           onMouseClicked="#goToLeccion4">
                        <font><Font name="Yu Gothic Light" size="17.0"/></font>
                    </Label>

                    <!-- L5 -->
                    <Label text="Lección 2: Entrada y salida" textFill="WHITE"
                           onMouseClicked="#goToLeccion5">
                        <font><Font name="Yu Gothic Light" size="17.0"/></font>
                    </Label>

                    <!-- (sin handler hasta que exista Leccion6) -->
                    <Label text="Lección 3: Operadores básicos" textFill="WHITE">
                        <font><Font name="Yu Gothic Light" size="17.0"/></font>
                    </Label>
                </VBox>
            </content>
            <font><Font size="18.0"/></font>
        </TitledPane>

        <!-- Sección 3 -->
        <TitledPane text="Sección 3: Control de flujo" textFill="WHITE">
            <content>
                <VBox spacing="10" style="-fx-background-color: #809fff;">
                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                    <Label text="Lección 1: Condicionales if/else" textFill="WHITE">
                        <font><Font name="Yu Gothic Light" size="17.0"/></font>
                    </Label>
                    <Label text="Lección 2: Bucles for y while" textFill="WHITE">
                        <font><Font name="Yu Gothic Light" size="17.0"/></font>
                    </Label>
                    <Label text="Lección 3: Ejercicios prácticos" textFill="WHITE">
                        <font><Font name="Yu Gothic Light" size="17.0"/></font>
                    </Label>
                </VBox>
            </content>
            <font><Font size="17.0"/></font>
        </TitledPane>

    </VBox>

    <ImageView fitHeight="61.0" fitWidth="70.0" layoutX="1579.0" layoutY="783.0" pickOnBounds="true" preserveRatio="true">
        <image><Image url="@/Image/General/StellaEsquinaSF.png"/></image>
    </ImageView>

    <!-- Barra superior (tuya, sin cambios) -->
    <Pane layoutX="165.0" layoutY="46.0" prefHeight="80.0" prefWidth="1690.0" style="-fx-background-color: #ffffff;">
        <children>
            <Button layoutX="188.0" layoutY="21.0" style="-fx-background-color: transparent; -fx-font-size: 18px;" text="Logros"/>
            <Button layoutX="541.0" layoutY="21.0" style="-fx-background-color: transparent; -fx-font-size: 18px;" text="Dinero"/>
            <Button layoutX="852.0" layoutY="21.0" style="-fx-background-color: transparent; -fx-font-size: 18px;" text="Racha 🔥"/>
            <Button layoutX="1138.0" layoutY="18.0" style="-fx-background-color: transparent; -fx-font-size: 18px;" text="Pomodoro ⏱"/>
        </children>
    </Pane>

    <!-- Barra inferior (copiada de Principal) -->
    <StackPane layoutX="-1.0" layoutY="867.0" prefHeight="80" prefWidth="1920.0">
        <children>
            <Rectangle arcHeight="0" arcWidth="0" height="80"
                       style="-fx-fill: rgba(8,7,54,0.55);" width="1923.0"/>
            <AnchorPane prefHeight="56.0" prefWidth="1876.0">
                <children>
                    <Button fx:id="homeBtn" layoutX="346.0" layoutY="12.0"
                            onAction="#goHome" styleClass="nav-btn">
                        <graphic>
                            <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                                <image><Image url="@/Image/General/home.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="forumBtn" layoutX="688.0" layoutY="12.0"
                            onAction="#goForum" styleClass="nav-btn">
                        <graphic>
                            <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                                <image><Image url="@/Image/General/foro.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="achievementsBtn" layoutX="1202.0" layoutY="12.0"
                            onAction="#goAchievements" styleClass="nav-btn">
                        <graphic>
                            <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                                <image><Image url="@/Image/General/trofeo.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="profileBtn" layoutX="1585.0" layoutY="12.0"
                            onAction="#goProfile" styleClass="nav-btn">
                        <graphic>
                            <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                                <image><Image url="@/Image/General/usuario.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>
                </children>
            </AnchorPane>
        </children>
    </StackPane>

</Pane>
