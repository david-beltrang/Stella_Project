<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<Pane maxHeight="1080.0" maxWidth="1920.0" minHeight="1080.0" minWidth="1920.0"
      prefHeight="1080.0" prefWidth="1920.0"
      stylesheets="@/styles/LoginStyle.css"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Infrastructure.controllers.PomodoroController">

    <children>
        <Label layoutX="465.0" layoutY="118.0" prefHeight="158.0" prefWidth="1436.0"
               text="CURSO C++ - LECCION 1" textFill="white">
            <font><Font name="System Bold" size="92.0"/></font>
        </Label>

        <ImageView fitHeight="61.0" fitWidth="70.0" layoutX="1579.0" layoutY="783.0"
                   pickOnBounds="true" preserveRatio="true">
            <image><Image url="@/Image/General/StellaEsquinaSF.png"/></image>
        </ImageView>

        <Label layoutX="748.0" layoutY="243.0" text="Historia y uso de C++" textFill="WHITE">
            <font><Font name="Monospaced Regular" size="40.0"/></font>
        </Label>

        <Accordion layoutX="716.0" layoutY="551.0"/>

        <Label layoutX="416.0" layoutY="301.0" prefHeight="113.0" prefWidth="1166.0"
               text="C++ es un lenguaje de programación creado por Bjarne Stroustrup en 1979 en los laboratorios Bell. Originalmente se llamó &quot;C con clases&quot; y fue diseñado como una extensión del lenguaje C, agregando características de programación orientada a objetos."
               textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <Label layoutX="419.0" layoutY="441.0" prefHeight="31.0" prefWidth="358.0"
               text="Características principales:" textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <Label layoutX="470.0" layoutY="523.0" prefHeight="33.0" prefWidth="696.0"
               text="• Lenguaje compilado (se traduce a código máquina)" textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <Label layoutX="467.0" layoutY="486.0" prefHeight="33.0" prefWidth="948.0"
               text="• Multiparadigma (procedimental, orientado a objetos, genérico)" textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <Label layoutX="468.0" layoutY="559.0" prefHeight="33.0" prefWidth="672.0"
               text="• Alto rendimiento y eficiencia" textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <Label layoutX="471.0" layoutY="591.0" prefHeight="1.0" prefWidth="1026.0"
               text="• Control granular sobre los recursos del sistema" textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <Label layoutX="415.0" layoutY="643.0" prefHeight="31.0" prefWidth="358.0"
               text="Ámbitos de uso:" textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <Label layoutX="465.0" layoutY="692.0" prefHeight="33.0" prefWidth="948.0"
               text="• Sistemas operativos" textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <Label layoutX="467.0" layoutY="725.0" prefHeight="33.0" prefWidth="948.0"
               text="• Videojuegos y gráficos" textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <Label layoutX="901.0" layoutY="692.0" prefHeight="33.0" prefWidth="948.0"
               text="• Aplicaciones científicas" textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <Label layoutX="902.0" layoutY="726.0" prefHeight="33.0" prefWidth="948.0"
               text="• Navegadores web" textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0"/></font>
        </Label>

        <!-- Botones correctamente cableados -->
        <Button layoutX="745.0" layoutY="795.0" mnemonicParsing="false" opacity="0.9"
                prefHeight="47.0" prefWidth="242.0" style="-fx-background-color: #080736;"
                text="VOLVER" textFill="WHITE" onAction="#prevFrom1">
            <font><Font name="System Bold" size="30.0"/></font>
        </Button>

        <Button layoutX="1038.0" layoutY="796.0" mnemonicParsing="false" opacity="0.9"
                prefHeight="47.0" prefWidth="242.0" style="-fx-background-color: #080736;"
                text="SIGUIENTE" textFill="WHITE" onAction="#nextFrom1">
            <font><Font name="System Bold" size="30.0"/></font>
        </Button>

        <!-- BARRA INFERIOR (igual a Principal) -->
        <StackPane layoutX="-1.0" layoutY="867.0" prefHeight="80" prefWidth="1920.0">
            <children>
                <Rectangle arcHeight="0" arcWidth="0" height="80"
                           style="-fx-fill: rgba(8,7,54,0.55);" width="1923.0"/>
                <AnchorPane prefHeight="56.0" prefWidth="1876.0">
                    <children>
                        <Button fx:id="homeBtn" layoutX="346.0" layoutY="12.0"
                                onAction="#goHome" styleClass="nav-btn">
                            <graphic>
                                <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                                    <image><Image url="@/Image/General/home.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="forumBtn" layoutX="688.0" layoutY="12.0"
                                onAction="#goForum" styleClass="nav-btn">
                            <graphic>
                                <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                                    <image><Image url="@/Image/General/foro.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="achievementsBtn" layoutX="1202.0" layoutY="12.0"
                                onAction="#goAchievements" styleClass="nav-btn">
                            <graphic>
                                <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                                    <image><Image url="@/Image/General/trofeo.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="profileBtn" layoutX="1585.0" layoutY="12.0"
                                onAction="#goProfile" styleClass="nav-btn">
                            <graphic>
                                <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                                    <image><Image url="@/Image/General/usuario.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </AnchorPane>
            </children>
        </StackPane>

    </children>
</Pane>
