<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane fx:id="root"
      maxHeight="1080.0" maxWidth="1920.0"
      minHeight="1080.0" minWidth="1920.0"
      prefHeight="1080.0" prefWidth="1920.0"
      stylesheets="@../styles/LoginStyle.css"
      xmlns="http://javafx.com/javafx/18.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Infrastructure.controllers.LeccionController">
    <!-- Barra inferior -->
    <StackPane layoutX="-1.0" layoutY="867.0" prefHeight="80" prefWidth="1920.0">
        <children>
            <Rectangle arcHeight="0" arcWidth="0" height="80" style="-fx-fill: rgba(8,7,54,0.55);" width="1923.0" />
            <AnchorPane prefHeight="56.0" prefWidth="1876.0">
                <children>
                    <Button fx:id="homeBtn" layoutX="346.0" layoutY="12.0" onAction="#goHome" styleClass="nav-btn">
                        <graphic><ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                            <image><Image url="@../Image/General/home.png" /></image>
                        </ImageView></graphic>
                    </Button>

                    <Button fx:id="forumBtn" layoutX="687.0" layoutY="10.0" onAction="#goForum" styleClass="nav-btn">
                        <graphic><ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                            <image><Image url="@../Image/General/foro.png" /></image>
                        </ImageView></graphic>
                    </Button>

                    <Button fx:id="profileBtn" layoutX="1585.0" layoutY="12.0" onAction="#goProfile" styleClass="nav-btn">
                        <graphic><ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                            <image><Image url="@../Image/General/usuario.png" /></image>
                        </ImageView></graphic>
                    </Button>

                    <!-- 2) NUEVO: botón Pomodoro en la barra inferior (entre fueguito y pescado) -->
                    <Button fx:id="pomodoroBtn" layoutX="1293.0" layoutY="10.0" onAction="#goPomodoro" style="-fx-background-color: transparent;">
                        <graphic>
                            <ImageView fitHeight="52.0" fitWidth="66.0" preserveRatio="true">
                                <image><Image url="@../Image/General/pomodoro.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="Tienda" layoutX="991.0" layoutY="12.0" onAction="#goForum" styleClass="nav-btn">
                        <graphic>
                            <ImageView fitHeight="32.0" fitWidth="48.0" preserveRatio="true">
                                <image>
                                    <Image url="@../Image/General/tienda.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <!-- 1) ELIMINADO: botón pomodoro de la barra inferior -->
                    <!-- (se movió a la barra superior) -->
                </children>
            </AnchorPane>
        </children>
    </StackPane>
    <children>
        <!-- TÍTULO GRANDE -->
        <Label fx:id="TituloSeccion"
               layoutX="311.0" layoutY="118.0"
               prefHeight="158.0" prefWidth="1168.0"
               textFill="white">
            <font><Font name="System Bold" size="92.0" /></font>
        </Label>

        <!-- ⏱ CRONÓMETRO (AGREGADO) -->
        <Label fx:id="lblTiempoPomodoro"
               layoutX="1720.0" layoutY="24.0"
               prefWidth="150.0" prefHeight="36.0"
               text="25:00"
               style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-color: transparent;" />

        <!-- PINGÜINO -->
        <ImageView fitHeight="61.0" fitWidth="70.0"
                   layoutX="1579.0" layoutY="783.0"
                   pickOnBounds="true" preserveRatio="true">
            <image>
            </image>
        </ImageView>

        <!-- NOMBRE LECCIÓN -->
        <Label fx:id="NombreLeccion1"
               layoutX="646.0" layoutY="249.0"
               prefHeight="47.0" prefWidth="584.0"
               textFill="WHITE">
            <font><Font name="Monospaced Regular" size="40.0" /></font>
        </Label>

        <!-- DESCRIPCIÓN -->
        <Label fx:id="DescripcionLeccion1"
               layoutX="416.0" layoutY="301.0"
               prefHeight="113.0" prefWidth="1166.0"
               textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0" /></font>
        </Label>

        <!-- SUBTÍTULO CARACTERÍSTICAS -->
        <Label fx:id="CaracteristicasTituloLeccion1"
               layoutX="419.0" layoutY="441.0"
               prefHeight="31.0" prefWidth="358.0"
               textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0" /></font>
        </Label>

        <!-- LISTA CARACTERÍSTICAS -->
        <Label fx:id="Caracteristicas1"
               layoutX="467.0" layoutY="486.0"
               prefHeight="33.0" prefWidth="948.0"
               textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0" /></font>
        </Label>

        <!-- SUBTÍTULO ÁMBITOS -->
        <Label fx:id="AmbitosdeUsoTtitulo1"
               layoutX="415.0" layoutY="643.0"
               prefHeight="31.0" prefWidth="358.0"
               textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0" /></font>
        </Label>

        <!-- ÁMBITOS -->
        <Label fx:id="Ambitos1"
               layoutX="465.0" layoutY="692.0"
               prefHeight="33.0" prefWidth="948.0"
               textAlignment="JUSTIFY" textFill="WHITE" wrapText="true">
            <font><Font name="Arial" size="29.0" /></font>
        </Label>

        <!-- BOTONES -->
        <Button layoutX="745.0" layoutY="795.0"
                mnemonicParsing="false" opacity="0.9"
                prefHeight="47.0" prefWidth="242.0"
                style="-fx-background-color: #080736;"
                text="VOLVER" onAction="#navegarALeccionAnterior" textFill="WHITE">
            <font><Font name="System Bold" size="30.0" /></font>
        </Button>

        <Button layoutX="1038.0" layoutY="796.0"
                mnemonicParsing="false" opacity="0.9"
                prefHeight="47.0" prefWidth="242.0"
                style="-fx-background-color: #080736;"
                text="SIGUIENTE" onAction="#navegarALeccionSiguiente" textFill="WHITE">
            <font><Font name="System Bold" size="30.0" /></font>
        </Button>
    </children>
</Pane>
