<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="1080.0" maxWidth="1920.0"
      minHeight="1080.0" minWidth="1920.0"
      prefHeight="1080.0" prefWidth="1920.0"
      stylesheets="@../../../CssStyle/LoginStyle.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.stellaa.StellaController">

    <children>
        <Button fx:id="pomodoroButton"
                text="Ir al Pomodoro"
                layoutX="850" layoutY="500"
                onAction="#goToPomodoro"
                style="-fx-background-color: #080736; -fx-text-fill: white;">
            <font><Font size="22.0" /></font>
        </Button>

        <Button fx:id="volverButton"
                text="Cerrar Sesión"
                layoutX="850" layoutY="580"
                onAction="#goBackToLogin"
                style="-fx-background-color: #080736; -fx-text-fill: white;">
            <font><Font size="22.0" /></font>
        </Button>
    </children>
</Pane>
