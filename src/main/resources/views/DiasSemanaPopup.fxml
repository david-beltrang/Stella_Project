<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.shape.Rectangle?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane prefWidth="800.0" prefHeight="500.0"
            style="-fx-background-color: rgba(8,7,54,0.93);
                   -fx-background-radius: 25;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 45, 0.3, 0, 6);"
            stylesheets="@../styles/LoginStyle.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Infrastructure.controllers.DiasSemanaPopupController">

    <children>

        <!-- Fondo -->
        <Rectangle arcHeight="25.0" arcWidth="25.0"
                   height="750.0" width="800.0"
                   style="-fx-fill: rgba(8,7,54,0.93);" />

        <!-- TÍTULO -->
        <Label fx:id="titleLabel"
               layoutX="30" layoutY="20"
               text="Semana"
               textFill="WHITE"
               style="-fx-font-size: 24; -fx-font-weight: bold;" />

        <GridPane fx:id="daysGrid"
                  layoutX="40"
                  layoutY="90"
                  prefWidth="720"
                  prefHeight="360"
                  hgap="15"
                  vgap="10">

            <!-- 7 columnas, una por cada día -->
            <children>

                <!-- LUNES -->
                <ScrollPane fx:id="scrollDay1" fitToWidth="true" prefWidth="90" prefHeight="350">
                    <content>
                        <VBox fx:id="dayBox1" spacing="8" alignment="TOP_CENTER"/>
                    </content>
                </ScrollPane>

                <!-- MARTES -->
                <ScrollPane fx:id="scrollDay2" GridPane.columnIndex="1" fitToWidth="true">
                    <content>
                        <VBox fx:id="dayBox2" spacing="8" alignment="TOP_CENTER"/>
                    </content>
                </ScrollPane>

                <!-- MIÉRCOLES -->
                <ScrollPane fx:id="scrollDay3" GridPane.columnIndex="2" fitToWidth="true">
                    <content>
                        <VBox fx:id="dayBox3" spacing="8" alignment="TOP_CENTER"/>
                    </content>
                </ScrollPane>

                <!-- JUEVES -->
                <ScrollPane fx:id="scrollDay4" GridPane.columnIndex="3" fitToWidth="true">
                    <content>
                        <VBox fx:id="dayBox4" spacing="8" alignment="TOP_CENTER"/>
                    </content>
                </ScrollPane>

                <!-- VIERNES -->
                <ScrollPane fx:id="scrollDay5" GridPane.columnIndex="4" fitToWidth="true">
                    <content>
                        <VBox fx:id="dayBox5" spacing="8" alignment="TOP_CENTER"/>
                    </content>
                </ScrollPane>

                <!-- SÁBADO -->
                <ScrollPane fx:id="scrollDay6" GridPane.columnIndex="5" fitToWidth="true">
                    <content>
                        <VBox fx:id="dayBox6" spacing="8" alignment="TOP_CENTER"/>
                    </content>
                </ScrollPane>

                <!-- DOMINGO -->
                <ScrollPane fx:id="scrollDay7" GridPane.columnIndex="6" fitToWidth="true">
                    <content>
                        <VBox fx:id="dayBox7" spacing="8" alignment="TOP_CENTER"/>
                    </content>
                </ScrollPane>

            </children>
        </GridPane>


        <!-- Botón cerrar -->
        <Button text="X"
                layoutX="750"
                layoutY="20"
                onAction="#cerrar"
                style="-fx-background-color: crimson;
                       -fx-text-fill: white;
                       -fx-font-size: 16;
                       -fx-background-radius: 999;" />

    </children>
</AnchorPane>
