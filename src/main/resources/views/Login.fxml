<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="1080.0" maxWidth="1920.0"
      minHeight="1080.0" minWidth="1920.0"
      prefHeight="1080.0" prefWidth="1920.0"
      stylesheets="@/styles/LoginStyle.css"
      xmlns="http://javafx.com/javafx/18.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Infrastructure.controllers.LoginController">

    <children>
        <Label layoutX="459.0" layoutY="65.0" prefHeight="388.0" prefWidth="873.0"
               text="STELLA" textFill="WHITE">
            <font><Font name="Franklin Gothic Demi" size="180.0"/></font>
        </Label>

        <Label layoutX="624.0" layoutY="342.0" text="Iniciar Sesión" textFill="WHITE">
            <font><Font size="47.0"/></font>
        </Label>

        <!-- Correo -->
        <TextField fx:id="correoField" layoutX="547.0" layoutY="430.0"
                   prefHeight="60.0" prefWidth="426.0" promptText="Correo"
                   style="-fx-font-size: 24px;"/>

        <!-- Contraseña -->
        <PasswordField fx:id="passwordField" layoutX="547.0" layoutY="509.0"
                       prefHeight="60.0" prefWidth="426.0" promptText="Contraseña"
                       style="-fx-font-size: 24px;"/>

        <!-- Ingresar -->
        <Button layoutX="547.0" layoutY="608.0" mnemonicParsing="false" opacity="0.8"
                prefHeight="60.0" prefWidth="200.0" style="-fx-background-color: #080736;"
                text="Ingresar" textFill="WHITE" onAction="#onLoginClicked">
            <font><Font name="System Bold" size="24.0"/></font>
        </Button>

        <!-- Volver -->
        <Button fx:id="backButton" layoutX="773.0" layoutY="608.0" mnemonicParsing="false"
                opacity="0.8" prefHeight="60.0" prefWidth="200.0" style="-fx-background-color: #080736;"
                text="Volver" textFill="WHITE" onAction="#onBackClicked">
            <font><Font name="System Bold" size="24.0"/></font>
        </Button>

        <!-- ¿Olvidaste tu contraseña? -->
        <Button fx:id="forgotPasswordButton" layoutX="547.0" layoutY="672.0" mnemonicParsing="false"
                prefHeight="40.0" prefWidth="426.0"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-underline: true;"
                text="¿Olvidaste tu contraseña?" onAction="#onForgotClicked">
            <font><Font size="18.0"/></font>
        </Button>

        <ImageView fitHeight="61.0" fitWidth="70.0" layoutX="1359.0" layoutY="753.0"
                   pickOnBounds="true" preserveRatio="true">
            <image><Image url="@/Image/General/StellaEsquinaSF.png"/></image>
        </ImageView>
    </children>
</Pane>