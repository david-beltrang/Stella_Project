<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="popupRoot" prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: rgba(8,7,54,0.93);                    -fx-background-radius: 25;                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 45, 0.3, 0, 6);" stylesheets="@../styles/LoginStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Infrastructure.controllers.ChatbotController">

    <!-- Fondo translúcido -->
    <Rectangle arcHeight="25.0" arcWidth="25.0" height="750.0" style="-fx-fill: rgba(8,7,54,0.93);" width="1100.0" />

    <!-- Encabezado del Chatbot -->
    <HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="1100.0" style="-fx-background-color: rgba(77,163,255,0.7); -fx-background-radius: 25 25 0 0;">
        <children>
            <ImageView fitHeight="60.0" fitWidth="60.0" layoutX="20.0" preserveRatio="true">
                <image>
                    <Image url="@../Image/General/ChatBot.png" />
                </image>
            </ImageView>
            <Label prefHeight="40.0" prefWidth="212.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Stella ChatBot">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Button fx:id="btnCerrar" onAction="#cerrarPopup" prefHeight="55.0" prefWidth="81.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 24;" text="✕" />
        </children>
        <padding>
            <Insets left="20.0" />
        </padding>
    </HBox>

    <!-- Contenedor principal -->
    <VBox alignment="TOP_CENTER" layoutY="80.0" prefHeight="670.0" prefWidth="1100.0" spacing="10.0">
        <children>
            <!-- Área de mensajes -->
            <ScrollPane fx:id="chatScrollPane" fitToWidth="true" prefHeight="530.0" prefWidth="1050.0" style="-fx-background: transparent; -fx-background-color: transparent;">
                <content>
                    <VBox fx:id="chatContainer" alignment="TOP_CENTER" prefHeight="530.0" prefWidth="1020.0" spacing="15.0">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Área de texto + botón enviar -->
            <HBox alignment="CENTER" prefHeight="70.0" prefWidth="1050.0" spacing="10.0" style="-fx-background-color: rgba(240,240,240,0.9); -fx-background-radius: 15;">
                <children>
                    <TextArea fx:id="messageInput" prefHeight="50.0" prefWidth="900.0" promptText="Escribe tu mensaje aquí..." style="-fx-background-radius: 15; -fx-border-radius: 15; -fx-font-size: 16;" wrapText="true" />
                    <Button fx:id="sendButton" onAction="#enviarMensaje" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #4DA3FF; -fx-background-radius: 25;">
                        <graphic>
                            <ImageView fitHeight="25.0" fitWidth="25.0" preserveRatio="true">
                                <image>
                                    <Image url="@../Image/General/Enviar.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </children>
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
            </HBox>
        </children>
    </VBox>
</AnchorPane>
