<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<Pane maxHeight="1080.0" maxWidth="1920.0"
      minHeight="1080.0" minWidth="1920.0"
      prefHeight="1080.0" prefWidth="1920.0"
      stylesheets="@../../../CssStyle/LoginStyle.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.stellaa.PomodoroController">


    <children>
        <ImageView fitHeight="138.0" fitWidth="139.0" layoutX="1253.0" layoutY="325.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../Image/StellaPomodoroSF.png" />
            </image>
        </ImageView>
        <Label fx:id="timerLabel" layoutX="870" layoutY="450"
               text="25:00" textFill="WHITE">
            <font><Font size="60.0"/></font>
        </Label>

        <Button fx:id="startButton" layoutX="860" layoutY="550"
                text="Iniciar"
                onAction="#startTimer"
                style="-fx-background-color: #080736; -fx-text-fill: white;">
            <font><Font size="22.0"/></font>
        </Button>

        <Button layoutX="860" layoutY="620"
                text="Volver"
                onAction="#goBack"
                style="-fx-background-color: #080736; -fx-text-fill: white;">
            <font><Font size="22.0"/></font>
        </Button>
    </children>
</Pane>
