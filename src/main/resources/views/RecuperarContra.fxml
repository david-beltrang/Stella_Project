<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="1080.0" maxWidth="1920.0"
      minHeight="1080.0" minWidth="1920.0"
      prefHeight="1080.0" prefWidth="1920.0"
      stylesheets="@../styles/LoginStyle.css"
      xmlns="http://javafx.com/javafx/18.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Infrastructure.controllers.LoginController">

    <children>
        <Label layoutX="467.0" layoutY="65.0"
               prefHeight="388.0" prefWidth="873.0"
               text="STELLA" textFill="WHITE">
            <font>
                <Font name="Franklin Gothic Demi" size="180.0" />
            </font>
        </Label>

        <Label layoutX="544.0" layoutY="357.0"
               text="Recuperar Contraseña" textFill="WHITE">
            <font><Font size="47.0" /></font>
        </Label>

        <Label layoutX="583.0" layoutY="426.0"
               prefWidth="426.0"
               style="-fx-font-size: 18px;"
               text="Ingresa tu email y te enviaremos un enlace para restablecer tu contraseña"
               textAlignment="CENTER"
               textFill="WHITE" wrapText="true" />

        <TextField fx:id="recoverEmailField"
                   layoutX="547.0" layoutY="500.0"
                   prefHeight="60.0" prefWidth="465.0"
                   promptText="Ingresa tu email"
                   style="-fx-font-size: 24px;" />

        <Button fx:id="sendRecoveryButton"
                layoutX="547.0" layoutY="580.0"
                mnemonicParsing="false"
                onAction="#sendRecoveryEmail"
                opacity="0.8"
                prefHeight="60.0" prefWidth="200.0"
                style="-fx-background-color: #080736;"
                text="Enviar Enlace" textFill="WHITE">
            <font><Font name="System Bold" size="24.0" /></font>
        </Button>

        <!-- 🔹 Botón corregido -->
        <Button fx:id="backToLoginButton"
                layoutX="773.0" layoutY="580.0"
                mnemonicParsing="false"
                onAction="#goBackToLogin"
                opacity="0.8"
                prefHeight="60.0" prefWidth="236.0"
                style="-fx-background-color: #080736;"
                text="Volver al Login" textFill="WHITE">
            <font><Font name="System Bold" size="24.0" /></font>
        </Button>

        <Label fx:id="recoveryMessage"
               layoutX="547.0" layoutY="650.0"
               prefWidth="426.0"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"
               textFill="#90EE90" visible="false"
               wrapText="true" />

        <ImageView fitHeight="61.0" fitWidth="70.0"
                   layoutX="1359.0" layoutY="663.0"
                   pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../Image/General/StellaEsquinaSF.png" />
            </image>
        </ImageView>
    </children>

</Pane>