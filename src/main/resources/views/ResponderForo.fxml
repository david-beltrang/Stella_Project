<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" maxHeight="1080.0" maxWidth="1920.0" prefHeight="1080.0" prefWidth="1920.0" stylesheets="@../styles/LoginStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Fondo -->
    <ImageView fx:id="background" fitHeight="1080" fitWidth="1920" layoutX="1.0" preserveRatio="false">
        <image>
            <Image url="@../Image/General/FondoStella.jpg" />
        </image>
    </ImageView>

    <!-- Barra superior -->
    <StackPane layoutX="-1.0" layoutY="32.0" prefHeight="80" prefWidth="1920.0">
        <children>
            <Rectangle arcHeight="0" arcWidth="0" height="80" style="-fx-fill: rgba(8,7,54,0.55);" width="1923.0" />
            <AnchorPane prefHeight="56.0" prefWidth="1876.0">
                <children>
                    <Button fx:id="homeBtn" layoutX="346.0" layoutY="7.0" prefWidth="60.0" styleClass="nav-btn">
                        <graphic>
                            <ImageView fitHeight="36.0" fitWidth="38.0" preserveRatio="true">
                                <image><Image url="@../Image/General/Trofeo.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <ImageView fitHeight="61.0" fitWidth="65.0" layoutX="633.0" layoutY="11.0" preserveRatio="true">
                        <image><Image url="@../Image/General/racha.png" /></image>
                    </ImageView>

                    <ImageView fitHeight="237.0" fitWidth="90.0" layoutX="1205.0" layoutY="14.0" preserveRatio="true">
                        <image><Image url="@../Image/General/pescaditos.png" /></image>
                    </ImageView>

                    <Button fx:id="chatBtn" layoutX="975.0" layoutY="9.0" styleClass="nav-btn">
                        <graphic>
                            <ImageView fitHeight="35.0" fitWidth="35.0" preserveRatio="true">
                                <image><Image url="@../Image/General/ChatBot.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="logoutBtn" layoutX="1630.0" layoutY="15.0" style="-fx-background-color: #4DA3FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 6 14;" text="Cerrar sesión">
                        <font>
                            <Font name="System Bold Italic" size="27.0" />
                        </font>
                    </Button>
                    <Button layoutX="692.0" layoutY="23.0" mnemonicParsing="false" prefHeight="39.0" prefWidth="123.0" />
                    <Button layoutX="1304.0" layoutY="22.0" mnemonicParsing="false" prefHeight="39.0" prefWidth="123.0" />
                </children>
            </AnchorPane>
        </children>
    </StackPane>

    <!-- Barra inferior -->
    <StackPane layoutX="-1.0" layoutY="867.0" prefHeight="80" prefWidth="1920.0">
        <children>
            <Rectangle arcHeight="0" arcWidth="0" height="80" style="-fx-fill: rgba(8,7,54,0.55);" width="1923.0" />
            <AnchorPane prefHeight="56.0" prefWidth="1876.0">
                <children>
                    <Button fx:id="homeBtn" layoutX="346.0" layoutY="12.0" onAction="#goHome" styleClass="nav-btn">
                        <graphic><ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                            <image><Image url="@../Image/General/home.png" /></image>
                        </ImageView></graphic>
                    </Button>

                    <Button fx:id="forumBtn" layoutX="687.0" layoutY="10.0" onAction="#goForum" styleClass="nav-btn">
                        <graphic><ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                            <image><Image url="@../Image/General/foro.png" /></image>
                        </ImageView></graphic>
                    </Button>

                    <Button fx:id="profileBtn" layoutX="1585.0" layoutY="12.0" onAction="#goProfile" styleClass="nav-btn">
                        <graphic><ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                            <image><Image url="@../Image/General/usuario.png" /></image>
                        </ImageView></graphic>
                    </Button>

                    <Button fx:id="iguluBtn" layoutX="1293.0" layoutY="10.0" style="-fx-background-color: transparent;">
                        <graphic>
                            <ImageView fitHeight="52.0" fitWidth="66.0" preserveRatio="true">
                                <image><Image url="@../Image/General/Iglu.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="tiendaBtn" layoutX="994.0" layoutY="10.0" onAction="#goTienda" styleClass="nav-btn">
                        <graphic>
                            <ImageView fitHeight="35.0" fitWidth="35.0" preserveRatio="true">
                                <image><Image url="@../Image/General/tienda.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>
                </children>
            </AnchorPane>
        </children>
    </StackPane>

    <!-- Contenido principal de respuesta -->
    <VBox layoutX="200.0" layoutY="150.0" prefHeight="568.0" prefWidth="1548.0" spacing="20.0" style="-fx-background-color: transparent;">

        <!-- Pregunta original -->
        <VBox spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 10; -fx-padding: 20;">
            <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Pregunta Original">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>

            <!-- Contenido de la pregunta -->
            <VBox spacing="10.0" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 8; -fx-padding: 15;">
                <Label fx:id="preguntaTitulo" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Pregunta" />
                <Label fx:id="preguntaContenido" style="-fx-text-fill: white; -fx-font-size: 16px;" text="Descipcion Pregunta" wrapText="true" />
                <HBox spacing="20.0" />
            </VBox>
        </VBox>

        <!-- Respuestas existentes -->
        <VBox spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 10; -fx-padding: 20;">
            <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Respuestas">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>

            <!-- Respuesta 1 -->
            <VBox spacing="8.0" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 8; -fx-padding: 15;">
                <Label style="-fx-text-fill: white; -fx-font-size: 16px;" wrapText="true" />
                <HBox spacing="20.0" />
            </VBox>
        </VBox>

        <!-- Formulario para nueva respuesta -->
        <VBox prefHeight="115.0" prefWidth="1452.0" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 10; -fx-padding: 20;">
            <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Tu Respuesta">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>

            <TextArea fx:id="respuestaTextArea" prefHeight="150.0" promptText="Escribe tu respuesta aquí..." style="-fx-background-color: rgba(255,255,255,0.8); -fx-background-radius: 5;" wrapText="true" />

            <HBox spacing="15.0">
                <Button style="-fx-background-color: #080737; -fx-text-fill: white; -fx-background-radius: 5; -fx-pref-width: 120;" text="Cancelar" />
                <Button style="-fx-background-color: #080737; -fx-text-fill: white; -fx-background-radius: 5; -fx-pref-width: 150;" text="Enviar Respuesta" />
            </HBox>
        </VBox>

    </VBox>
   <Button layoutX="719.0" layoutY="729.0" mnemonicParsing="false" prefHeight="77.0" prefWidth="434.0" text="Volver al Foro" textFill="WHITE">
      <font>
         <Font name="System Bold" size="37.0" />
      </font>
   </Button>

</AnchorPane>
